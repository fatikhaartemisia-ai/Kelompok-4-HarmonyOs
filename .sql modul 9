USE bank_sampah_digital;

-- ==========================================
-- 1. PRE-TEST (Atribut Turunan / Saldo)
-- ==========================================
-- Tanpa atribut turunan (memakai SUM dan JOIN yang berat):
SELECT p.nama,       
       COALESCE((SELECT SUM(total) FROM setoran 
                 WHERE id_nasabah = n.id_pengguna), 0)     
     - COALESCE((SELECT SUM(jumlah) FROM penarikan 
                 WHERE id_nasabah = n.id_pengguna), 0)       
       AS hitung_saldo_manual
FROM nasabah n
JOIN pengguna p ON n.id_pengguna = p.id_pengguna
WHERE n.id_pengguna = 1;

-- Dengan menggunakan atribut turunan (kolom saldo):
SELECT saldo
FROM nasabah
WHERE id_pengguna = 1;


-- ==========================================
-- 2. TAHAP 1: EKSPLORASI JOIN (Sebelum Denormalisasi)
-- ==========================================
SELECT p.id_pengguna,       
       p.nama,       
       COUNT(s.id_setoran) AS jumlah_setoran,       
       SUM(s.berat)        AS total_berat,       
       SUM(s.total)        AS total_nilai_rp
FROM pengguna p
JOIN nasabah n ON p.id_pengguna = n.id_pengguna
JOIN setoran s ON n.id_pengguna = s.id_nasabah
GROUP BY p.id_pengguna, p.nama;

-- Analisis performa dengan EXPLAIN:
EXPLAIN
SELECT p.id_pengguna,       
       p.nama,       
       COUNT(s.id_setoran) AS jumlah_setoran,       
       SUM(s.berat)        AS total_berat,       
       SUM(s.total)        AS total_nilai_rp
FROM pengguna p
JOIN nasabah n ON p.id_pengguna = n.id_pengguna
JOIN setoran s ON n.id_pengguna = s.id_nasabah
GROUP BY p.id_pengguna, p.nama;


-- ==========================================
-- 3. TAHAP 2: PENERAPAN DENORMALISASI (DDL & UPDATE)
-- ==========================================
-- Menambahkan kolom turunan total_setoran_rp pada tabel nasabah:
ALTER TABLE nasabah  
ADD COLUMN total_setoran_rp DECIMAL(15,2) NOT NULL DEFAULT 0;

-- Mengisi kolom turunan dari ringkasan SUM tabel setoran:
UPDATE nasabah n
JOIN (    
    SELECT id_nasabah, SUM(total) AS total    
    FROM setoran    
    GROUP BY id_nasabah
) x ON x.id_nasabah = n.id_pengguna 
SET n.total_setoran_rp = x.total;


-- ==========================================
-- 4. TAHAP 3: PEMBUKTIAN (Tanpa JOIN & Agregasi)
-- ==========================================
SELECT id_pengguna AS id_nasabah, total_setoran_rp
FROM nasabah
ORDER BY total_setoran_rp DESC;

-- Analisis performa sesudah denormalisasi dengan EXPLAIN:
EXPLAIN
SELECT id_pengguna AS id_nasabah, total_setoran_rp
FROM nasabah
ORDER BY total_setoran_rp DESC;


-- ==========================================
-- 5. POST-TEST: QUERY JOIN KOMPLEKS & PANGGILAN
-- ==========================================
-- (1) Query JOIN kompleks dengan pengurutan:
SELECT p.id_pengguna,       
       p.nama,       
       COUNT(s.id_setoran) AS jumlah_setoran,       
       SUM(s.berat)        AS total_berat,       
       SUM(s.total)        AS total_nilai_rp
FROM pengguna p
JOIN nasabah n ON p.id_pengguna = n.id_pengguna
JOIN setoran s ON n.id_pengguna = s.id_nasabah
GROUP BY p.id_pengguna, p.nama
ORDER BY total_nilai_rp DESC;

-- (2) Script pemanggilan data denormalisasi:
SELECT id_pengguna AS id_nasabah, total_setoran_rp
FROM nasabah
ORDER BY total_setoran_rp DESC;
